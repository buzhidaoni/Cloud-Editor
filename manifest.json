{
    "manifest_version": 3,
    "name": "✦ Cloud Editor",
    "version": "11.45.14",
    "description": "源码云功能",
    "permissions": ["scripting"],
    "host_permissions": [
        "*://player.codemao.cn/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://player.codemao.cn/*"
            ],
            "js": ["content.js"],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["inject.js", "libs/*.js"],
            "matches": ["*://player.codemao.cn/*"]
        }
    ]
}
